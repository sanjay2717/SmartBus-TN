# Optional lab-deployment overrides.
# All three defaults are already baked into src/config.js:
#   VITE_WS_URL=ws://localhost:8000/ws
#   VITE_API_URL=http://localhost:8000
#   VITE_CAMERA_URL=http://localhost:8000/video
#
# Only uncomment if you are serving from a different host.

INGEST_KEY=<shared secret>
DOORS_EXPECTED=2                # set to 1 if only one camera
CAPACITY=10                     # env var; raise for accuracy tests

